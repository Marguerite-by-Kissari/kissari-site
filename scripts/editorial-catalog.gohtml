{{- $articles := slice -}}
{{- range (where site.RegularPages "Section" "blog").ByPublishDate.Reverse -}}
  {{- if and (not .Draft) (not (.PublishDate.After now)) -}}
    {{- $articles = $articles | append (dict "path" .RelPermalink "title" .Title "category" (delimit .Params.categories ", ") "date" (.PublishDate.Format "2006-01-02")) -}}
  {{- end -}}
{{- end -}}
{{- dict "schema_version" 1 "generated_at" (now.Format "2006-01-02T15:04:05Z07:00") "config" site.Data.blog_editorial "base_config_sha256" (sha256 (readFile "data/blog_editorial.json")) "articles" $articles | jsonify -}}
